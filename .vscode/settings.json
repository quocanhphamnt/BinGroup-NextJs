{
    "stylelint.validate": ["css", "scss"],
    "css.lint.unknownAtRules": "ignore",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.fixAll.stylelint": "explicit",
      "source.sortImports": "never",
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit",
      "source.sortMembers": "explicit"
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "cSpell.words": [
      "autofocus",
      "camelcase",
      "Chanels",
      "crumblist",
      "Cryptr",
      "customsearch",
      "deduping",
      "flowtype",
      "FOOTERYEAR",
      "formik",
      "gcse",
      "gname",
      "googlesearch",
      "grecaptcha",
      "gsearch",
      "hasher",
      "hookform",
      "infomation",
      "insuance",
      "largedesktop",
      "lastest",
      "leadform",
      "lib/utils",
      "libphonenumber",
      "linebreak",
      "maxage",
      "mediumdesktop",
      "mediumphone",
      "multilines",
      "oneibc",
      "oneibccom",
      "oneline",
      "paren",
      "parsetags",
      "RECAPTCHA",
      "reduxjs",
      "roachjs",
      "roboto",
      "sáàảãạăắằẳẵặâấầẩẫậéèẻẽẹêếềểễệíìỉĩịóòỏõọôốồổỗộơớờởỡợúùủũụưứừửữựýỳỷỹỵ",
      "scrolldown",
      "smalldesktop",
      "smallphone",
      "stylelint",
      "swiper",
      "Swipper",
      "tailwindcss",
      "Tiktok",
      "Touchs",
      "Trawick",
      "xlargedesktop",
      "xsmallphone",
      "zustand"
    ],
    "[html]": {
      "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    }
  }
  